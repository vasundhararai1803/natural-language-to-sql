# Paste your Groq API key here:
OPENAI_API_KEY=gsk_your_actual_groq_api_key_here

# Point to Groq's OpenAI-compatible endpoint:
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Use any fast Groq model (e.g. llama-3.3-70b-versatile or llama-3.1-8b-instant):
OPENAI_MODEL=llama-3.3-70b-versatile

# Leave this as is for the local SQLite database:
DATABASE_URL=sqlite:///data/querylens.db
